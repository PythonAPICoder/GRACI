{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "external_directory": "deny"
  },

  "enabled_providers": [
    "openai",
    "google",
    "ollama",
    "opencode"
  ],

  "provider": {
    "openai": {
      "whitelist": [
        "gpt-5.6-sol"
      ]
    },

    "google": {
      "whitelist": [
        "gemini-3.7-flash"
      ]
    },

    "ollama": {
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },

      "models": {
        "gpt-oss:20b": {
          "name": "GPT-OSS 20B"
        }
      }
    },

    "opencode": {
      "whitelist": [
        "deepseek-v4-flash-free",
        "mimo-v2.5-free",
        "nemotron-3-ultra-free",
        "laguna-s-2.1-free"
      ]
    }
  }
}