{
  "name": "graci",
  "version": "0.1.0",
  "description": "G.R.A.C.I. — General Reasoning, Automation, Coordination, and Intelligence",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "node build.js",
    "start": "electron .",
    "dev": "concurrently \"npm run watch\" \"wait-on dist/main.js && npm start\"",
    "watch": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-store": "^10.0.0",
    "express": "^5.1.0",
    "sql.js": "^1.12.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "wait-on": "^9.0.1"
  }
}
