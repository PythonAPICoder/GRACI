      "dual": "2.0-6.0 ms attack; two oscillators share the same compact smooth decay",
      "stepped": "1.0-4.0 ms attack; 2-4 inharmonic frequency plateaus share one compact smooth decay"
    },
    "web_audio_mapping": {
      "timbre": "OscillatorNode.type uses sine, triangle, square, or sawtooth",
      "frequency": "setValueAtTime plus exponentialRampToValueAtTime; stepped events use additional setValueAtTime calls",
      "amplitude": "one GainNode envelope per oscillator; all values remain positive for exponential ramps",
      "stereo": "StereoPannerNode with the documented bounded pan range",
      "dual_tone": "two OscillatorNodes feeding one event bus with the documented inharmonic ratio and secondary gain",
      "scheduling": "AudioContext.currentTime plus independently randomized episode, cluster, and intra-cluster offsets"
    }
  },
